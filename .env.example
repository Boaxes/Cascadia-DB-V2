# Settings the site reads from environment variables (config/settings.py).
# The site never reads a .env file: Docker sets these in docker-compose.yml, the native setup sets them
# in local/env.ps1, and the server sets them in its service file. Values below are examples only.

# Long random string; a new one per machine.
DJANGO_SECRET_KEY=change-me
# true only on a developer machine.
DJANGO_DEBUG=false
# false only when the site is served over plain http on a developer machine.
DJANGO_SECURE=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgis://unified@localhost:55433/unified
# Where DuckLake keeps its Parquet files.
DUCKLAKE_DATA_PATH=/srv/unified-db/ducklake
# Windows only: GDAL and GEOS from the PostGIS bundle in PostgreSQL's bin folder.
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=
DJANGO_LOG_LEVEL=INFO
