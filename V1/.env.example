# Copy to .env and fill in. .env is gitignored and must stay that way.
#
#     cp .env.example .env
#
# Docker Compose reads this same file, so the POSTGRES_* values below are what
# the local database is created with.

# --- Local Postgres (docker compose) ----------------------------------------
POSTGRES_DB=cascadia
POSTGRES_USER=cascadia
POSTGRES_PASSWORD=cascadia
# Host port. 5433 keeps out of the way of a Postgres already on 5432.
POSTGRES_PORT=5433
WEB_PORT=8000

# --- Database -----------------------------------------------------------------
# As seen from inside a container, where the database is the host "db".
DATABASE_URL=postgresql://cascadia:cascadia@db:5432/cascadia
#
# From the host -- pgAdmin, psql, DBeaver -- it is instead:
#     postgresql://cascadia:cascadia@localhost:5433/cascadia
#
# In production this points at the droplet's own Postgres over the loopback
# address, and carries a real password.
#
# PIPELINE_DATABASE_URL is where the data pipeline (ETL/) writes: raw, build,
# dbo and app. Publishing a run replaces the dbo and app the website reads, so
# in production it must be the website's OWN database, written as the droplet
# sees it (the daily workflow's secret of the same name is this, and the
# workflow reaches it through an SSH tunnel):
#     postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME
# Leave it unset on a laptop to try the import in a separate database called
# `pipeline`, which the website never reads and ops/pull-db.sh never touches.
# PIPELINE_DATABASE_URL=postgresql://cascadia:cascadia@db:5432/pipeline

# --- DB167, the MS SQL Server being replaced -----------------------------------
# READ ONLY. The import selects from it and never writes.
# Needed only while the import is being run; blank otherwise.
DB167_ODBC=DRIVER={ODBC Driver 18 for SQL Server};SERVER=;DATABASE=;UID=;PWD=;Encrypt=yes;TrustServerCertificate=yes

# --- DigitalOcean Spaces, the GPS track files ---------------------------------
# A local copy should not work on the real bucket: a test save there changes the
# only authoritative copy of a track. Copy the files down once instead:
#     SPACES_KEY=... SPACES_SECRET=... python manage.py download_track_files tracks
# and set SPACES_LOCAL_DIR to that folder. While it is set, every read and write
# goes to the folder and never to the bucket, so the key can stay blank here.
SPACES_LOCAL_DIR=
# Where the checks of each GPS file are kept, one JSON file per track file
# (manage.py check_track_files). Defaults to track-checks beside the Django folder.
TRACK_CHECKS_DIR=
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=sfo3
SPACES_BUCKET=gps-tracks

# --- Django -------------------------------------------------------------------
# This key only signs local session cookies, so it is fine in the open and the
# same for everyone. The server has its own, which is not in this repository.
DJANGO_SECRET_KEY=1evljvmvs$6)tpvg9k)s^-1oqit92k-vrffr@sn-gqo*gn@o+6
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Feedback, the site's Feedback page -----------------------------------------
# Feedback becomes an issue in this GitHub repository. The token is a
# fine-grained personal access token limited to this one repository, with
# Issues set to Read and Write. Left empty, the page says feedback is not set
# up yet and shows no form.
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPO=Boaxes/Cascadia-DB

# --- Local SQL Server: copies of DB167 for testing ----------------------------
# Two databases, DB167_Today and DB167_LastImport, built by ETL/mirror_sqlserver.py
# (docker compose --profile mssql up -d mssql, then run it in the etl container).
# Connect from DBeaver to localhost, port MSSQL_PORT, user sa. SQL Server
# requires the password to have 8+ characters from three of: upper, lower,
# digits, symbols. Any local value will do; it never leaves this machine.
MSSQL_SA_PASSWORD=
MSSQL_PORT=1433
