# Copy to .env and fill in. .env is gitignored and must stay that way.
#
#     cp .env.example .env
#
# Docker Compose reads this same file, so the POSTGRES_* values below are what
# the local database is created with.

# --- Local Postgres (docker compose) ----------------------------------------
POSTGRES_DB=cascadia
POSTGRES_USER=cascadia
POSTGRES_PASSWORD=cascadia
# Host port. 5433 keeps out of the way of a Postgres already on 5432.
POSTGRES_PORT=5433
WEB_PORT=8000

# --- Database -----------------------------------------------------------------
# As seen from inside a container, where the database is the host "db".
DATABASE_URL=postgresql://cascadia:cascadia@db:5432/cascadia
#
# From the host -- pgAdmin, psql, DBeaver -- it is instead:
#     postgresql://cascadia:cascadia@localhost:5433/cascadia
#
# In production this points at the droplet's own Postgres over the loopback
# address, and carries a real password.

# --- DB167, the MS SQL Server being replaced -----------------------------------
# READ ONLY. The import selects from it and never writes.
# Needed only while the import is being run; blank otherwise.
DB167_ODBC=DRIVER={ODBC Driver 18 for SQL Server};SERVER=;DATABASE=;UID=;PWD=;Encrypt=yes;TrustServerCertificate=yes

# --- DigitalOcean Spaces, the GPS track files ---------------------------------
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=sfo3
SPACES_BUCKET=gps-tracks

# --- Django -------------------------------------------------------------------
# This key only signs local session cookies, so it is fine in the open and the
# same for everyone. The server has its own, which is not in this repository.
DJANGO_SECRET_KEY=1evljvmvs$6)tpvg9k)s^-1oqit92k-vrffr@sn-gqo*gn@o+6
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
